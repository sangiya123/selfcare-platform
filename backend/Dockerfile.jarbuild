# Local fast-path image: packages prebuilt host jars
# (backend/<MODULE>/target/<MODULE>-1.0.0-SNAPSHOT.jar) instead of running
# Maven inside the container. Runtime layout matches backend/<service>/Dockerfile.
#
# The in-container Maven multi-stage build keeps re-downloading dependencies
# and fails on flaky Maven-Central access under Docker Desktop; prebuilding on
# the host reuses the warm ~/.m2 repository and makes the local stack build
# deterministic. CI still uses the full multi-stage Dockerfiles.
#
# Usage (from repo root):
#   mvn -f backend/pom.xml clean package -Dmaven.test.skip=true
#   docker compose build

FROM eclipse-temurin:25-jre-alpine
WORKDIR /app

RUN addgroup -g 1000 -S selfcare && adduser -u 1000 -S selfcare -G selfcare

ENV JAVA_TOOL_OPTIONS="-Xmx768m -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom"

HEALTHCHECK --interval=30s --timeout=10s --start-period=1800s --retries=5 \
  CMD wget --quiet --tries=1 --spider http://localhost:${SERVER_PORT:-8080}/actuator/health || exit 1

ARG MODULE
COPY backend/${MODULE}/target/${MODULE}-1.0.0-SNAPSHOT.jar app.jar

USER selfcare
EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]