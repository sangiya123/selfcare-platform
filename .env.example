# =====================================================================
# OMOBIO Selfcare Platform — Top-level .env.example
# Copy to .env.<env> (dev, stg, reg, prod) and load via docker-compose.
#
# Usage:
#   cp .env.example .env.dev
#   OMOBIO_ENV=dev docker-compose up -d
# =====================================================================

# Active environment
OMOBIO_ENV=dev
SPRING_PROFILES_ACTIVE=dev

# =====================================================================
# MySQL (Auth, Profile, Read models, Audit)
# =====================================================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=omobio_selfcare
DB_USERNAME=omobio
DB_PASSWORD=omobio
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5

# =====================================================================
# MongoDB (Config source of truth)
# =====================================================================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=omobio_config
MONGO_USERNAME=omobio
MONGO_PASSWORD=omobio
MONGO_AUTH_SOURCE=admin
MONGO_URI=mongodb://omobio:omobio@mongodb:27017/omobio_config?authSource=admin

# =====================================================================
# Redis (Hot cache, sessions, entitlement)
# =====================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=omobio
REDIS_DATABASE=0

# =====================================================================
# Kafka (Event streaming)
# =====================================================================
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_PREFIX=omobio
KAFKA_CONSUMER_GROUP=omobio-platform
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# =====================================================================
# JWT (ADR-011 — token policy subject to security review)
# =====================================================================
JWT_SIGNING_KEY=change-me-in-production-must-be-256-bits
JWT_ISSUER=omobio-selfcare
JWT_ACCESS_TOKEN_TTL=42d
JWT_REFRESH_TOKEN_TTL=210d
JWT_KEY_ID=omobio-key-1

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081

# =====================================================================
# AI Gateway
# =====================================================================
AI_GATEWAY_ENABLED=true
AI_DEFAULT_MODEL=claude-3-5-sonnet
AI_PROVIDER_ANTHROPIC_API_KEY=replace-me
AI_RAG_TOP_K=5
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3
AI_DAILY_COST_LIMIT_USD=100

# =====================================================================
# Feature Flags (Unleash)
# =====================================================================
UNLEASH_API_URL=http://unleash:4242/api
UNLEASH_INSTANCE_ID=omobio-platform
UNLEASH_APP_NAME=omobio-selfcare
UNLEASH_API_KEY=replace-me
UNLEASH_ENVIRONMENT=development

# =====================================================================
# Observability (Grafana, Prometheus, OTel)
# =====================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

PROMETHEUS_RETENTION=15d
PROMETHEUS_PORT=9090

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=omobio-platform
OTEL_RESOURCE_ATTRIBUTES=service.namespace=omobio,deployment.environment=dev

# =====================================================================
# Service URLs (cross-service discovery within compose)
# =====================================================================
CUSTOMER_IDENTITY_URL=http://customer-identity-service:8080
ADMIN_IDENTITY_URL=http://admin-identity-service:8080
CONFIG_TENANT_URL=http://config-tenant-service:8080
ACCOUNT_ENTITLEMENT_URL=http://account-entitlement-service:8080
DASHBOARD_BFF_URL=http://dashboard-bff:8080
PRODUCT_URL=http://product-service:8080
USAGE_URL=http://usage-service:8080
BILLING_URL=http://billing-service:8080
PAYMENT_URL=http://payment-service:8080
NOTIFICATION_URL=http://notification-service:8080
CONTENT_URL=http://content-service:8080
JOURNEY_URL=http://journey-service:8080
REPORTING_URL=http://reporting-service:8080
AI_GATEWAY_URL=http://ai-gateway:8080
AUDIT_URL=http://audit-service:8080
INSURANCE_URL=http://insurance-service:8080

# API Gateway
API_GATEWAY_URL=http://api-gateway:8080
SERVER_PORT=8080

# =====================================================================
# Mobile App (read by selfcare-app at build time)
# =====================================================================
MOBILE_ENV=development
MOBILE_API_BASE_URL=http://localhost:8080
MOBILE_TENANT_ID=dialog-lk
MOBILE_SCHEME=omobio
MOBILE_ANALYTICS_KEY=replace-me
MOBILE_SENTRY_DSN=

# =====================================================================
# Admin Studio (selfcare-studio dev server)
# =====================================================================
VITE_API_BASE_URL=http://localhost:8080
VITE_DEFAULT_TENANT_ID=dialog-lk
VITE_ENV=dev
