{
  "mappings": [
    {
      "name": "Dialog Balance Provider - Success",
      "request": {
        "method": "GET",
        "urlPath": "/api/balance",
        "queryParameters": {
          "connectionId": {
            "matches": "CONN-.*"
          }
        }
      },
      "response": {
        "status": 200,
        "jsonBody": {
          "connectionId": "{{request.query.connectionId}}",
          "amount": 1250.75,
          "currency": "LKR",
          "balanceType": "MAIN",
          "asOf": "{{now}}",
          "lastRecharge": {
            "amount": 1000.00,
            "date": "2026-08-25T10:30:00Z"
          }
        },
        "headers": {
          "Content-Type": "application/json",
          "X-Provider": "DialogBSS"
        }
      }
    },
    {
      "name": "Dialog Balance Provider - Connection Not Found",
      "request": {
        "method": "GET",
        "urlPath": "/api/balance",
        "queryParameters": {
          "connectionId": {
            "matches": "CONN-INVALID-.*"
          }
        }
      },
      "response": {
        "status": 404,
        "jsonBody": {
          "error": "Connection not found",
          "code": "CONN_NOT_FOUND"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
