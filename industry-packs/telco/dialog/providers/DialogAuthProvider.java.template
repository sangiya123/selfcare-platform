package com.omobio.providers.dialog.auth;

import com.omobio.platform.common.adapter.ApiAdapter;
import com.omobio.platform.common.adapter.RegisterAdapter;
import com.omobio.platform.common.web.ServiceUnavailableException;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;
import org.springframework.web.reactive.function.client.WebClient;
import reactor.core.publisher.Mono;

import java.time.Duration;

/**
 * Dialog Authentication Provider.
 *
 * Authenticates against Dialog's identity system via OTP.
 * Returns a canonical AuthResult for use by customer-identity-service.
 *
 * Configuration in application.yml:
 *   omobio.providers.dialog.auth.base-url: https://auth.dialog.lk
 *   omobio.providers.dialog.auth.timeout-ms: 5000
 *   omobio.providers.dialog.auth.client-id: ${DIALOG_AUTH_CLIENT_ID}
 *   omobio.providers.dialog.auth.client-secret: ${DIALOG_AUTH_CLIENT_SECRET}
 */
@Slf4j
@Component
@RegisterAdapter(tenantId = "dialog-lk", providerInterface = ApiAdapter.class)
public class DialogAuthProvider implements ApiAdapter {

    @Override
    public String getAdapterId() {
        return "dialog-lk";
    }

    @Value("${omobio.providers.dialog.auth.base-url:https://auth.dialog.lk}")
    private String baseUrl;

    @Value("${omobio.providers.dialog.auth.timeout-ms:5000}")
    private long timeoutMs;

    private final WebClient webClient;

    public DialogAuthProvider(WebClient.Builder builder) {
        this.webClient = builder
                .baseUrl("https://auth.dialog.lk")
                .defaultHeader("User-Agent", "omobio-selfcare/1.0")
                .build();
    }

    /**
     * Request OTP for a phone number.
     */
    public Mono<OtpRequestResult> requestOtp(String msisdn, String tenantId) {
        return webClient.post()
                .uri("/api/v1/otp/request")
                .bodyValue(OtpRequest.builder().msisdn(msisdn).build())
                .retrieve()
                .bodyToMono(OtpRequestResult.class)
                .timeout(Duration.ofMillis(timeoutMs))
                .onErrorMap(e -> new ServiceUnavailableException("DialogAuthProvider", "OTP request failed: " + e.getMessage(), true));
    }

    /**
     * Verify OTP and return a session token.
     */
    public Mono<SessionResult> verifyOtp(String msisdn, String otp, String referenceId, String tenantId) {
        return webClient.post()
                .uri("/api/v1/otp/verify")
                .bodyValue(OtpVerification.builder().msisdn(msisdn).otp(otp).referenceId(referenceId).build())
                .retrieve()
                .bodyToMono(SessionResult.class)
                .timeout(Duration.ofMillis(timeoutMs))
                .onErrorMap(e -> new ServiceUnavailableException("DialogAuthProvider", "OTP verify failed: " + e.getMessage(), true));
    }

    @lombok.Data
    @lombok.Builder
    public static class OtpRequest {
        private String msisdn;
    }

    @lombok.Data
    @lombok.Builder
    public static class OtpRequestResult {
        private String referenceId;
        private int expiresIn;
        private String status;
    }

    @lombok.Data
    @lombok.Builder
    public static class OtpVerification {
        private String msisdn;
        private String otp;
        private String referenceId;
    }

    @lombok.Data
    @lombok.Builder
    public static class SessionResult {
        private String sessionId;
        private String userId;
        private String displayName;
        private long expiresIn;
    }
}