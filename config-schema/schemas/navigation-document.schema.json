{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://selfcare.example.com/schemas/navigation-document.schema.json",
  "title": "NavigationDocument",
  "description": "Server-driven navigation graph for the Selfcare Platform. Defines bottom tabs, drawer items, quick actions, canonical routes, and deep/universal link mappings.",
  "type": "object",
  "required": [
    "schemaVersion",
    "tenantId",
    "name",
    "version",
    "status",
    "tabs",
    "drawerItems",
    "quickActions",
    "routes",
    "deepLinks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Navigation document name (e.g. 'default', 'enterprise-v1')"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "REVIEW", "APPROVED", "PUBLISHED", "ARCHIVED"]
    },
    "tabs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/Tab" }
    },
    "drawerItems": {
      "type": "array",
      "items": { "$ref": "#/$defs/DrawerItem" }
    },
    "quickActions": {
      "type": "array",
      "items": { "$ref": "#/$defs/QuickAction" }
    },
    "routes": {
      "type": "array",
      "description": "Canonical in-app route table (path -> screen/component)",
      "items": { "$ref": "#/$defs/Route" }
    },
    "universalLinks": {
      "type": "array",
      "description": "HTTPS universal links that map to in-app routes",
      "items": { "$ref": "#/$defs/UniversalLink" }
    },
    "deepLinks": {
      "type": "array",
      "description": "Custom-scheme deep link mappings",
      "items": { "$ref": "#/$defs/DeepLink" }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "owner": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "Tab": {
      "type": "object",
      "required": ["id", "label", "route"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "icon": {
          "type": "string",
          "description": "Icon asset name (e.g. 'home', 'wallet', 'recharge')"
        },
        "route": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9/_-]*$",
          "description": "Canonical route path"
        },
        "badge": {
          "type": "object",
          "properties": {
            "source": { "type": "string" },
            "max": { "type": "integer", "minimum": 1, "maximum": 999 }
          }
        },
        "visibleWhen": {
          "type": "object",
          "properties": {
            "feature": { "type": "string" },
            "lob": {
              "type": "string",
              "enum": ["MOBILE", "BB", "DTV", "FIBRE", "ENTERPRISE"]
            },
            "segment": { "type": "string" }
          },
          "additionalProperties": true
        },
        "order": {
          "type": "integer",
          "default": 99
        }
      },
      "additionalProperties": false
    },
    "DrawerItem": {
      "type": "object",
      "required": ["id", "label", "route"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "icon": { "type": "string" },
        "route": { "type": "string", "pattern": "^/[a-zA-Z0-9/_-]*$" },
        "section": { "type": "string", "description": "Group/section the drawer item belongs to" },
        "requiresAuth": { "type": "boolean", "default": true },
        "visibleWhen": {
          "type": "object",
          "additionalProperties": true
        },
        "order": { "type": "integer", "default": 99 }
      },
      "additionalProperties": false
    },
    "QuickAction": {
      "type": "object",
      "required": ["id", "label", "action"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "icon": { "type": "string" },
        "action": { "$ref": "#/$defs/NavAction" },
        "visibleWhen": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "NavAction": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "NAVIGATE",
            "OPEN_WEB",
            "OPEN_WEB_SSO",
            "START_JOURNEY",
            "DEEP_LINK",
            "MODAL",
            "EXTERNAL_BROWSER"
          ]
        },
        "route": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "journeyId": { "type": "string" },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "analyticsEvent": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Route": {
      "type": "object",
      "required": ["path", "screen"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9/{}_-]*$",
          "description": "Canonical path with optional {param} placeholders"
        },
        "screen": {
          "type": "string",
          "minLength": 1,
          "description": "Screen component ID"
        },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["string", "number", "boolean"] },
              "required": { "type": "boolean" }
            }
          }
        },
        "requiresAuth": { "type": "boolean", "default": false },
        "guards": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "UniversalLink": {
      "type": "object",
      "required": ["host", "pathPattern", "route"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "Universal link host (e.g. 'app.example.com')"
        },
        "pathPattern": {
          "type": "string",
          "minLength": 1,
          "description": "Path pattern with optional {param} placeholders"
        },
        "route": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9/_-]*$",
          "description": "Internal canonical route to navigate to"
        },
        "paramMap": {
          "type": "object",
          "description": "Map of URL param names to internal param names",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "DeepLink": {
      "type": "object",
      "required": ["scheme", "pathPattern", "route"],
      "properties": {
        "scheme": {
          "type": "string",
          "minLength": 1,
          "description": "Custom URI scheme (e.g. 'myapp', 'selfcare')"
        },
        "pathPattern": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9/_-]*$"
        },
        "paramMap": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "fallbackUrl": {
          "type": "string",
          "format": "uri",
          "description": "Where to send the user if the app is not installed"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
