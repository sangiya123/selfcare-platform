{
  "title": "selfcare Customer Identity Service",
  "uid": "selfcare-customer-identity",
  "schemaVersion": 39,
  "version": 1,
  "description": "OTP, login, MFA, JWT and session metrics for the customer-identity-service. Runbook: https://runbooks.selfcare.local/customer-identity",
  "tags": ["selfcare", "customer-identity", "auth", "mfa"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": "Prometheus",
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "expr": "changes(deployment_started_total{service=\"customer-identity-service\"}[1m]) > 0",
        "tagKeys": "service,version,environment",
        "titleFormat": "Deploy customer-identity {{version}}"
      },
      {
        "name": "Replay Detections",
        "datasource": "Prometheus",
        "enable": true,
        "iconColor": "rgba(255, 200, 0, 1)",
        "expr": "changes(replay_detection_total{service=\"customer-identity-service\"}[1m]) > 0",
        "titleFormat": "Replay detected"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      },
      {
        "name": "tenant",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(otp_send_total{service=\"customer-identity-service\"}, tenant_id)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "label": "Tenant"
      },
      {
        "name": "channel",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(otp_send_total{service=\"customer-identity-service\"}, channel)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "label": "OTP Channel"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Login Success Rate",
      "description": "Successful login ratio (success / total login attempts).",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(login_attempts_total{service=\"customer-identity-service\",status=\"success\"}[5m])) / sum(rate(login_attempts_total{service=\"customer-identity-service\"}[5m]))",
          "legendFormat": "success"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "OTP Send Rate",
      "description": "OTPs dispatched per second across all channels.",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(otp_send_total{service=\"customer-identity-service\",tenant_id=~\"$tenant\",channel=~\"$channel\"}[1m]))",
          "legendFormat": "otp/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Sessions",
      "description": "Live authenticated sessions in Redis.",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(active_sessions{service=\"customer-identity-service\",tenant_id=~\"$tenant\"})",
          "legendFormat": "sessions"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed Logins (5m)",
      "description": "Cumulative failed login attempts over the last 5 minutes.",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(login_attempts_total{service=\"customer-identity-service\",status=\"failure\"}[5m]))",
          "legendFormat": "failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "MFA Verify Rate",
      "description": "MFA verification attempts per second.",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(mfa_verification_total{service=\"customer-identity-service\"}[1m]))",
          "legendFormat": "mfa/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "JWT Validation Errors (5m)",
      "description": "JWT tokens rejected for invalid signature, expiry, or claims.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(jwt_validation_errors_total{service=\"customer-identity-service\"}[5m]))",
          "legendFormat": "errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "OTP Send vs Verify Rate",
      "description": "OTP dispatch throughput vs successful verification. Gap indicates unconverted OTPs.",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(otp_send_total{service=\"customer-identity-service\",tenant_id=~\"$tenant\",channel=~\"$channel\"}[1m]))",
          "legendFormat": "send"
        },
        {
          "expr": "sum(rate(otp_verify_total{service=\"customer-identity-service\",tenant_id=~\"$tenant\",status=\"success\"}[1m]))",
          "legendFormat": "verify_success"
        },
        {
          "expr": "sum(rate(otp_verify_total{service=\"customer-identity-service\",tenant_id=~\"$tenant\",status=\"failure\"}[1m]))",
          "legendFormat": "verify_failure"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Login Success vs Failure",
      "description": "Authentications by outcome. Runbook: https://runbooks.selfcare.local/login-failures",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(login_attempts_total{service=\"customer-identity-service\",status=\"success\"}[1m]))",
          "legendFormat": "success"
        },
        {
          "expr": "sum(rate(login_attempts_total{service=\"customer-identity-service\",status=\"failure\"}[1m]))",
          "legendFormat": "failure"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Refresh Token Rate",
      "description": "Token refresh throughput. Sudden dips may indicate clock skew or revocation storms.",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(token_refresh_total{service=\"customer-identity-service\",tenant_id=~\"$tenant\"}[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Active Sessions by Tenant",
      "description": "Concurrent live sessions grouped by tenant.",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (tenant_id) (active_sessions{service=\"customer-identity-service\",tenant_id=~\"$tenant\"})",
          "legendFormat": "{{tenant_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "MFA Verification Outcomes",
      "description": "MFA attempts by outcome (success / failure / locked).",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(mfa_verification_total{service=\"customer-identity-service\"}[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "JWT Validation Errors by Reason",
      "description": "Rejected JWT tokens broken down by reason (expired, invalid signature, claim mismatch).",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (reason) (rate(jwt_validation_errors_total{service=\"customer-identity-service\"}[5m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Replay Detection Alerts (1h)",
      "description": "Detected token/nonce replays in the last hour. Any value > 0 requires security review.",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(replay_detection_total{service=\"customer-identity-service\"}[1h]))",
          "legendFormat": "replays"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Failed Logins by Tenant",
      "description": "Failed login attempts per tenant. Spikes may indicate credential stuffing.",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(login_attempts_total{service=\"customer-identity-service\",status=\"failure\",tenant_id=~\"$tenant\"}[1m]))",
          "legendFormat": "{{tenant_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max", "sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
