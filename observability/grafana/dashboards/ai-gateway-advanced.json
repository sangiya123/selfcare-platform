  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "title": "Chat Requests per Second (by tenant)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(ai_chat_requests_total[1m]))",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "title": "AI Chat p99 Latency (seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"ai-gateway\",uri=\"/api/v1/ai/chat\"}[5m])))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"ai-gateway\",uri=\"/api/v1/ai/chat\"}[5m])))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "title": "Token Usage by Provider (per hour)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (provider) (increase(ai_token_usage_total[1h]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "title": "Estimated Cost per Hour (USD)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ai_token_cost_usd_total[1h])) * 3600",
          "legendFormat": "USD/hour",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "id": 5,
      "title": "Tool Call Success Rate",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(ai_tool_calls_total{status=\"success\"}[5m])) / sum(rate(ai_tool_calls_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}}},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "id": 6,
      "title": "Moderation Flag Rate",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(ai_moderation_flagged_total[5m])) / sum(rate(ai_moderation_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}}},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "id": 7,
      "title": "Fallback Response Rate (LLM unhealthy)",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(ai_fallback_responses_total[5m])) / sum(rate(ai_chat_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 8,
      "title": "RAG Retrieval Latency (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ai_rag_retrieval_seconds_bucket[5m]))) * 1000",
          "legendFormat": "p99",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 9,
      "title": "Active Streaming Sessions",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(ai_streaming_sessions_active)",
          "legendFormat": "active streams",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}}},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32},
      "id": 10,
      "title": "Sentiment Distribution (5-min rolling)",
      "type": "barchart",
      "targets": [
        {
          "expr": "sum by (label) (increase(ai_sentiment_total[5m]))",
          "legendFormat": "{{label}}",
          "refId": "A"
        }
      ]
    }
  ],
