# =====================================================================
# Admin Studio — .env.example
# Switch with: vite --mode dev|stg|reg|prod  (or SELFCARE_ENV via Makefile)
#
# Operator-specific values (integration URLs, credentials) are NOT here —
# they're configured per-tenant via the Integrations page in this admin
# portal and stored in MongoDB. See docs/MULTI_TENANT_CONFIG.md.
# =====================================================================

# App identity
VITE_APP_ENV=dev

# Backend API
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_PUBLIC_API_BASE_URL=http://localhost:8080

# Portal URLs
VITE_ADMIN_PORTAL_URL=http://localhost:3000
VITE_OBSERVABILITY_URL=http://localhost:3001

# Server port
VITE_ADMIN_PORT=3000
