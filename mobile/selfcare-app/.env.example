# =====================================================================
# Mobile App — .env.example
# Copy to .env.<env> and load with:  ./scripts/load-env.sh <env>
# =====================================================================

# Active environment
MOBILE_ENV=dev

# API Gateway URL (platform-common base)
MOBILE_API_BASE_URL=http://localhost:8080

# Default tenant (can be overridden per app variant)
MOBILE_TENANT_ID=dialog-lk

# Mobile app scheme (deep linking)
MOBILE_SCHEME=selfcare

# Analytics
MOBILE_ANALYTICS_KEY=replace-me

# Crash reporting
MOBILE_SENTRY_DSN=replace-me
