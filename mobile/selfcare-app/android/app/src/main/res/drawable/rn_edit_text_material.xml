<?xml version="1.0" encoding="utf-8"?>
<!--
    Edit text background for React Native. The platform default may
    differ between API levels — we keep a flat tinted background.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/abc_edit_text_inset_horizontal_material"
    android:insetRight="@dimen/abc_edit_text_inset_horizontal_material"
    android:insetTop="@dimen/abc_edit_text_inset_top_material"
    android:insetBottom="@dimen/abc_edit_text_inset_bottom_material">
    <selector>
        <item android:state_enabled="false">
            <nine-patch
                android:alpha="?android:disabledAlpha"
                android:src="@drawable/abc_textfield_default_mtrl_alpha" />
        </item>
        <item>
            <nine-patch android:src="@drawable/abc_textfield_default_mtrl_alpha" />
        </item>
    </selector>
</inset>
