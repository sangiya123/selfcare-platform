<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand colors — defaults; tenant-specific overrides loaded at runtime
         from the manifest via theme resolver. These are the placeholders
         displayed before the manifest is fetched. -->
    <color name="brand_primary">#6C2DC7</color>
    <color name="brand_primary_dark">#4A1E8A</color>
    <color name="brand_primary_light">#A78BFA</color>
    <color name="brand_accent">#00B900</color>

    <!-- Status colors -->
    <color name="status_success">#388E3C</color>
    <color name="status_warning">#FFA000</color>
    <color name="status_error">#D32F2F</color>
    <color name="status_info">#1976D2</color>

    <!-- Neutral colors -->
    <color name="text_primary">#212121</color>
    <color name="text_secondary">#757575</color>
    <color name="text_disabled">#BDBDBD</color>
    <color name="background">#FFFFFF</color>
    <color name="surface">#F5F5F5</color>
    <color name="divider">#E0E0E0</color>

    <!-- Launch screen -->
    <color name="launch_background">#6C2DC7</color>
</resources>
