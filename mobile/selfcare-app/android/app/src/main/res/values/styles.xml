<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base application theme. Theme tokens are also applied at runtime
        from the tenant manifest; this is the shell-level default.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Brand color slots — overridden at runtime via the SDK theme engine -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_accent</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Launch screen theme — visible until React Native boots -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Theme applied after React Native boots and overrides the launch theme -->
    <style name="NormalTheme" parent="AppTheme">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>
</resources>
