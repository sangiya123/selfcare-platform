# ci/.env.ci — Local CI environment variables
# Copy to ci/.env.ci and fill in real values before starting.

# Jenkins admin credentials
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=Selfcare_J3nk1ns_Adm1n_Pa55w0rd!2026

# SonarQube token (create at http://sonarqube:9000 → My Account → Security)
