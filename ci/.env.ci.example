# Copy to ci/.env.ci and set values before starting the local CI stack.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=replace-with-a-long-local-password
# Create this token in SonarQube after first startup, then set it here.
SONAR_TOKEN=replace-with-sonarqube-token
# Optional: required only for private GitHub repositories.
GITHUB_TOKEN=
GITHUB_USERNAME=sangiya
